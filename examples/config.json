{
  "columns": {
    "order_id": {"aliases": ["order no", "order_no", "id", "رقم الطلب"], "type": "text", "case": "upper", "missing": "drop_row"},
    "customer": {"aliases": ["client name", "customer name", "العميل"], "type": "text", "case": "title", "arabic_letters": true, "missing": "constant:Unknown"},
    "region": {"aliases": ["area", "city", "المنطقة"], "type": "text", "case": "title",
      "value_map": {"الرياض": "Riyadh", "جدة": "Jeddah", "مكة المكرمة": "Makkah", "مكة": "Makkah", "mecca": "Makkah", "الدمام": "Dammam", "المدينة المنورة": "Madinah", "المدينة": "Madinah"}},
    "product": {"aliases": ["item", "المنتج"], "type": "text", "case": "title"},
    "quantity": {"aliases": ["qty", "الكمية"], "type": "integer", "missing": "median"},
    "unit_price": {"aliases": ["price", "price (sar)", "unit price", "سعر الوحدة"], "type": "number", "missing": "median"},
    "order_date": {"aliases": ["date", "تاريخ الطلب"], "type": "date", "missing": "keep"},
    "status": {"aliases": ["state", "الحالة"], "type": "text", "case": "title",
      "value_map": {"done": "Delivered", "canceled": "Cancelled", "تم التسليم": "Delivered", "قيد الانتظار": "Pending", "ملغي": "Cancelled", "مرتجع": "Returned"}}
  },
  "computed": {"line_total": "quantity * unit_price"},
  "duplicates": {
    "key": ["order_id", "customer", "region", "product", "quantity", "unit_price", "order_date"],
    "keep": "most_complete",
    "fuzzy_columns": ["customer", "product"],
    "fuzzy_block_by": ["order_date", "region"],
    "fuzzy_threshold": 0.88
  },
  "validation": [
    {"column": "order_id", "rule": "required"},
    {"column": "order_id", "rule": "regex", "pattern": "ORD-\\d{4,5}", "message": "order id must look like ORD-1234"},
    {"column": "order_id", "rule": "unique"},
    {"column": "customer", "rule": "required"},
    {"column": "region", "rule": "allowed", "values": ["Riyadh", "Jeddah", "Makkah", "Dammam", "Madinah"]},
    {"column": "quantity", "rule": "range", "min": 1, "max": 100},
    {"column": "unit_price", "rule": "range", "min": 0.01, "max": 50000},
    {"column": "order_date", "rule": "required"},
    {"column": "order_date", "rule": "range", "min": "2025-01-01", "max": "2025-12-31"},
    {"column": "status", "rule": "allowed", "values": ["Delivered", "Pending", "Cancelled", "Returned"]},
    {"column": "customer", "rule": "regex", "pattern": "(?!Unknown$).*", "severity": "warning", "message": "customer was missing and filled with 'Unknown'"}
  ],
  "report": {
    "title": "Sales Merge and Data Quality Report",
    "subtitle": "SYNTHETIC demo data generated by excel_engine.datagen. No real customers or sales.",
    "pivots": [
      {"name": "Revenue by region", "index": "region", "values": "line_total", "agg": "sum"},
      {"name": "Revenue by month", "index": "order_date", "values": "line_total", "agg": "sum", "freq": "M"},
      {"name": "Orders by status", "index": "region", "columns": "status", "agg": "count"}
    ],
    "charts": [
      {"pivot": "Revenue by region", "kind": "bar", "title": "Revenue by region (synthetic, SAR-like units)", "y_title": "revenue"},
      {"pivot": "Revenue by month", "kind": "line", "title": "Monthly revenue", "y_title": "revenue"},
      {"pivot": "Orders by status", "kind": "bar", "title": "Orders by region and status", "y_title": "orders"}
    ]
  }
}
